# ─────────────────────────────────────────────────────────────
# Base de datos (Prisma + PostgreSQL)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/name_of_your_database"

# ─────────────────────────────────────────────────────────────
# Servidor HTTP
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Origen permitido por CORS (la URL del frontend en desarrollo)
CORS_ORIGIN=http://localhost:5173
# Valor de `trust proxy` de Express. Depende del hosting:
#   false      → sin proxy delante (desarrollo local)
#   1          → un salto (Vercel, Render, Railway, Fly.io, un Nginx)
#   1,2        → varios saltos encadenados
#   10.0.0.0/8 → lista de IPs/CIDR de confianza
# `true` está prohibido: permite falsificar la IP y saltarse el rate limit.
TRUST_PROXY=false

# ─────────────────────────────────────────────────────────────
# Autenticación (better-auth)
# Genera el secreto con: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string
# Origen de la API, SIN el prefijo /api. better-auth añade /api/auth por basePath.
BETTER_AUTH_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────
# Modo de autenticación
# Defaults: credenciales activas y registro abierto (comportamiento histórico).
#   solo credenciales → deja los flags por defecto y no rellenes proveedores
#   solo proveedores  → AUTH_EMAIL_PASSWORD_ENABLED=false + una pareja completa
#   panel interno     → AUTH_SIGN_UP_ENABLED=false (los usuarios existentes entran)
# Sin credenciales y sin proveedor la API no arranca: no habría forma de entrar.
# ─────────────────────────────────────────────────────────────
AUTH_EMAIL_PASSWORD_ENABLED=true
AUTH_SIGN_UP_ENABLED=true
# Exige verificar el email antes de iniciar sesión con credenciales.
# El login social se controla por proveedor, no con esta variable.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ─────────────────────────────────────────────────────────────────────────────
# Proveedores sociales (opcional). Cada pareja debe estar completa.
# Callbacks a registrar en la consola de cada proveedor:
#   Google → ${BETTER_AUTH_URL}/api/auth/callback/google
#   GitHub → ${BETTER_AUTH_URL}/api/auth/callback/github
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# Email transaccional (Resend)
# Sin RESEND_API_KEY, en desarrollo se registra solo el asunto y el destinatario
# (nunca el enlace con el token). En producción es obligatoria: la API no arranca
# sin ella, así que el correo nunca se imprime en consola.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="AuthKit <onboarding@resend.dev>"

# ─────────────────────────────────────────────────────────────
# Rate limit de endpoints sensibles (reset y verificación de email)
# ─────────────────────────────────────────────────────────────
SENSITIVE_RATE_LIMIT_ENABLED=true
SENSITIVE_RATE_LIMIT_MAX=5
SENSITIVE_RATE_LIMIT_WINDOW_MINUTES=15

# ─────────────────────────────────────────────────────────────
# Rate limit general de /api/users y /api/admin
# ─────────────────────────────────────────────────────────────
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MINUTES=1

# ─────────────────────────────────────────────────────────────
# Mantenimiento
# ─────────────────────────────────────────────────────────────
# Minutos entre limpiezas de sesiones expiradas (default: 1440 = 1 día)
SESSION_CLEANUP_INTERVAL_MINUTES=1440
# Duración de la sesión y frecuencia de renovación, en segundos.
# Defaults de better-auth: 7 días de vida y renovación cada día.
SESSION_EXPIRES_IN=604800
SESSION_UPDATE_AGE=86400
# Nivel de logs de pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Roles
# ─────────────────────────────────────────────────────────────
# Correo del PRIMER administrador. Debe ser un usuario ya registrado.
# Se usa con: pnpm --filter api admin:bootstrap
ADMIN_EMAIL=
