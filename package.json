{
  "name": "authkit-fullstack",
  "version": "1.0.0",
  "private": true,
  "description": "AuthKit: monorepo fullstack de autenticación (React + Vite + Tailwind / Express + Prisma + better-auth)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "fix": "pnpm format && pnpm lint:fix"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
