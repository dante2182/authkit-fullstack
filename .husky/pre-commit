#!/usr/bin/env sh
# Pre-commit: formato, lint y tipado en todo el monorepo.
# Si falla, el commit se cancela. Arreglo rápido: pnpm fix

pnpm check || {
  echo ""
  echo "✖ Comprobaciones fallidas. Revisa la salida de arriba."
  echo "  Formato + lint automáticos: pnpm fix"
  echo "  Comprobación manual:        pnpm check"
  echo ""
  exit 1
}
