#!/usr/bin/env sh
# Valida el mensaje de commit con Conventional Commits.
# Si falla, el commit se cancela. Ver commitlint.config.mjs

pnpm exec commitlint --edit "$1" || {
  echo ""
  echo "✖ Mensaje de commit inválido."
  echo "  Formato: <tipo>(<scope opcional>): <descripción>"
  echo "  Tipos válidos: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  echo "  Ejemplo: feat(web): añade pantalla de login"
  echo ""
  exit 1
}
